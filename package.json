{
  "name": "compassrose",
  "version": "1.0.0",
  "description": "CompassRose is a CLI-first TypeScript application for deterministic AI-assisted software development orchestration.",
  "main": "./dist/cli/main.js",
  "directories": {
    "doc": "compassrose"
  },
  "scripts": {
    "test": "vitest run",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "setup": "tsx src/cli/main.ts setup",
    "feature-validation": "tsx src/cli/main.ts feature-validation",
    "dev": "tsx src/cli/main.ts",
    "doctor": "tsx src/cli/main.ts doctor",
    "dev:no-commit": "tsx src/cli/main.ts --no-commit",
    "app": "tsx src/cli/main.ts --loop",
    "app:codex": "tsx src/cli/main.ts --loop --implementer codex",
    "proto:typecheck": "tsc -p proto/tsconfig.json",
    "proto:e2e": "tsx proto/protoCompassRose.e2e.ts",
    "proto:e2e:codex": "cross-env PROTO_E2E_IMPLEMENTER=codex tsx proto/protoCompassRose.e2e.ts",
    "proto:e2e:unblock": "cross-env PROTO_E2E_SCENARIO=unblock tsx proto/protoCompassRose.e2e.ts",
    "proto:smoke": "tsx proto/protoCompassRose.smoke.e2e.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dragaminas/CompassRose.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/dragaminas/CompassRose/issues"
  },
  "homepage": "https://github.com/dragaminas/CompassRose#readme",
  "devDependencies": {
    "@types/node": "^25.9.1",
    "cross-env": "^10.1.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  },
  "bin": {
    "compassrose": "./dist/cli/main.js"
  }
}
