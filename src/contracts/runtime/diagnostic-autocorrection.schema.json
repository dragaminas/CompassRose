{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "feature_id",
    "diagnosis_summary",
    "blocker",
    "next_step",
    "next_step_reason",
    "interface_response",
    "systemic_blocker"
  ],
  "properties": {
    "feature_id": { "type": "string" },
    "diagnosis_summary": { "type": "string", "maxLength": 240 },
    "blocker": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "signature",
        "recoverability",
        "evidence"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "state_corruption",
            "task_interface_gap",
            "cli_mismatch",
            "environment",
            "implementation_failure",
            "review_failure",
            "unknown"
          ]
        },
        "signature": { "type": "string" },
        "recoverability": {
          "type": "string",
          "enum": ["auto", "agent", "human", "terminal"]
        },
        "evidence": {
          "type": "array",
          "items": { "type": "string", "maxLength": 160 }
        }
      }
    },
    "next_step": {
      "type": "string",
      "enum": [
        "correct_state",
        "block_for_conversation",
        "stop_with_diagnostic",
        "file_blocking_fix"
      ]
    },
    "next_step_reason": { "type": "string", "maxLength": 240 },
    "interface_response": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "summary",
        "target_paths"
      ],
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["none", "recovery_conversation", "manual_review"]
        },
        "summary": { "type": "string", "maxLength": 200 },
        "target_paths": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "systemic_blocker": {
      "anyOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["title", "evidence_summary", "scope_note", "severity"],
          "properties": {
            "title": { "type": "string" },
            "evidence_summary": { "type": "string", "maxLength": 240 },
            "scope_note": { "type": "string", "maxLength": 200 },
            "severity": { "type": "string", "enum": ["critical"] }
          }
        }
      ]
    }
  }
}
