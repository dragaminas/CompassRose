{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "acceptance_criteria_verification",
  "title": "Acceptance Criteria Verification",
  "type": "object",
  "additionalProperties": false,
  "required": ["feature_id", "verdicts", "summary"],
  "properties": {
    "feature_id": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 400,
      "description": "One or two sentences a human can read without opening anything else."
    },
    "verdicts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["criterion", "status", "evidence"],
        "properties": {
          "criterion": {
            "type": "string",
            "minLength": 1,
            "maxLength": 400,
            "description": "The acceptance criterion, quoted from feature.md."
          },
          "status": {
            "type": "string",
            "enum": ["met", "unmet", "unverifiable"],
            "description": "`unverifiable` means the evidence needed is not present in what was read. It counts as unmet: the default is always to keep the feature open."
          },
          "evidence": {
            "type": "string",
            "minLength": 1,
            "maxLength": 400,
            "description": "Concrete: a path, a symbol, a test name. Never a restatement of the criterion."
          }
        }
      }
    }
  }
}
