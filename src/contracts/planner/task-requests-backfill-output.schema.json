{
  "type": "object",
  "additionalProperties": false,
  "required": ["task_requests"],
  "properties": {
    "task_requests": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "objective", "scope", "status", "sibling_check", "covers_existing_task_ids"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "objective": { "type": "string" },
          "scope": {
            "type": "object",
            "additionalProperties": false,
            "required": ["allowed_paths", "forbidden_paths"],
            "properties": {
              "allowed_paths": {
                "type": "array",
                "items": { "type": "string" }
              },
              "forbidden_paths": {
                "type": "array",
                "items": { "type": "string" }
              }
            }
          },
          "status": {
            "type": "string",
            "enum": ["not_started", "in_progress", "complete", "superseded"]
          },
          "sibling_check": {
            "type": "object",
            "additionalProperties": false,
            "required": ["considered_features", "belongs_to_other_feature"],
            "properties": {
              "considered_features": {
                "type": "array",
                "items": { "type": "string" }
              },
              "belongs_to_other_feature": {
                "type": ["string", "null"]
              }
            }
          },
          "covers_existing_task_ids": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    }
  }
}
